# Development values only. Replace secrets before any non-local deployment.
POSTGRES_DB=personal_dot
POSTGRES_USER=personal_dot
POSTGRES_PASSWORD=personal_dot_dev
DATABASE_URL=postgresql+psycopg://personal_dot:personal_dot_dev@postgres:5432/personal_dot
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=personal-dot
RQ_JOB_TIMEOUT_SECONDS=3600
RQ_RESULT_TTL_SECONDS=300
RQ_FAILURE_TTL_SECONDS=604800
LOG_LEVEL=INFO
API_PORT=8000
SCHEDULER_POLL_SECONDS=5
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MAX_CATCH_UP=10
SCHEDULER_REQUEUE_AFTER_SECONDS=60
SCHEDULER_STALE_TASK_SECONDS=3900

# Required only when sending Pushover notifications. Never commit real values.
NOTIFICATION_PROVIDER=pushover
NOTIFICATION_TIMEOUT_SECONDS=10
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Required only for agent tasks. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_OUTPUT_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
AGENT_MAX_TOOL_ROUNDS=8

# Optional: docker compose -f compose.yaml -f compose.github.yaml ...
# Public identifiers, configured by the owner; key contents/tokens never go here.
GITHUB_OWNER=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_HOST_PATH=
DOT_GITHUB_UID=
DOT_GITHUB_GID=
# Non-Docker workers use GITHUB_APP_PRIVATE_KEY_PATH=/absolute/protected/key.pem
